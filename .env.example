# Copie para .env (ignorado pelo git). Aqui ficam SEGREDOS; URLs e regras dos ambientes ficam no
# qastage.config.json (versionado). Sem as variáveis do Jira, a integração fica desligada.

# Jira Cloud: e-mail + API token (https://id.atlassian.com/manage-profile/security/api-tokens)
QASTAGE_JIRA_URL=https://suaempresa.atlassian.net
QASTAGE_JIRA_EMAIL=voce@empresa.com
QASTAGE_JIRA_TOKEN=
# Jira Server/Data Center: use um Personal Access Token no lugar de e-mail + token
# QASTAGE_JIRA_PAT=

QASTAGE_JIRA_PROJECT=QA
# QASTAGE_JIRA_ISSUE_TYPE=Bug
# QASTAGE_JIRA_FLAVOR=cloud          # cloud | server (padrão: cloud se a URL for *.atlassian.net)
# QASTAGE_JIRA_ENVS=qa,homolog       # só estes ambientes abrem card (padrão: todos)
# QASTAGE_JIRA_ATTACH_TRACE=false    # o trace.zip pode conter dados digitados (senhas)
# QASTAGE_PUBLIC_URL=http://qastage.interno:4000   # para o card linkar o relatório

# Desenvolvimento local com o Jira de mentira (node examples/jira-fake/server.mjs):
# QASTAGE_JIRA_URL=http://localhost:4180
# QASTAGE_JIRA_FLAVOR=cloud
# QASTAGE_JIRA_EMAIL=fake@local
# QASTAGE_JIRA_TOKEN=fake

# Teste de carga (k6). A autorização fica no qastage.config.json ("carga": true no ambiente).
# QASTAGE_LOAD_ENVS só serve para projetos sem config (ou para liberar um ambiente pontualmente).
# QASTAGE_LOAD_ENVS=homolog-carga
# QASTAGE_LOAD_MAX_VUS=100           # teto de usuários virtuais por cenário
# QASTAGE_K6_BIN=k6                  # caminho do k6, se não estiver no PATH
