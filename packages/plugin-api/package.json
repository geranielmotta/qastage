{
  "name": "@qastage/plugin-api",
  "version": "0.0.0",
  "description": "Plugin api-testing: ingestão de OpenAPI/Swagger/Postman, corpo gerado pelo schema, contrato e negativos.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit && tsc --noEmit -p web && vite build --config web/vite.config.ts",
    "dev": "vite --config web/vite.config.ts",
    "test": "tsx --test src/runner/*.test.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@qastage/core-contract": "workspace:*",
    "@qastage/data": "workspace:*",
    "@qastage/feature": "workspace:*",
    "@qastage/web-kit": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.23.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-types": "^12.1.3",
    "vite": "^8.3.4"
  }
}
